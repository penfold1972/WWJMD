[config]
name="WWJMD"
version="0.1.0"
description="What Would John McClain Do? — A 3D FPS destruction sandbox"

[application]
run_mode=current
icon="res://assets/icon.svg"

[rendering]
renderer="forward_plus"
environment/default=res://assets/default_env.tres

[input]
move_forward={
"deadzone":0.5,
"events":[{"type":2,"device":1,"key":87}]
}
move_backward={
"deadzone":0.5,
"events":[{"type":2,"device":1,"key":83}]
}
move_left={
"deadzone":0.5,
"events":[{"type":2,"device":1,"key":65}]
}
move_right={
"deadzone":0.5,
"events":[{"type":2,"device":1,"key":68}]
}
look_left={
"deadzone":0.5,
"events":[{"type":2,"device":1,"key":81}]
}
look_right={
"deadzone":0.5,
"events":[{"type":2,"device":1,"key":69}]
}
shoot={
"deadzone":0.5,
"events":[{"type":2,"device":1,"key":32}]
}
melee={
"deadzone":0.5,
"events":[{"type":2,"device":1,"key":81}]
}
sprint={
"deadzone":0.5,
"events":[{"type":2,"device":1,"key":16777248}
]}

[physics]
3d/gravity=9.8

[debug]
settings/gdscript/warnings/treat_warnings_as_errors=false
